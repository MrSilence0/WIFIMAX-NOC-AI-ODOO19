<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="wifimax_noc_ai.HomeMenu">
        <div class="o_home_menu h-100 overflow-auto w-100 bg-light" style="position: absolute; top: 0; left: 0; z-index: 1000;">
            <div class="container mt-5">
                <div class="o_apps row user-select-none justify-content-center">
                    <t t-foreach="this.apps" t-as="app" t-key="app.id">
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4 text-center">
                            <a class="o_app d-flex flex-column align-items-center text-decoration-none"
                               href="#"
                               t-on-click.prevent="() => this.onAppClick(app)">
                                
                                <img t-if="app.webIconData"
                                     class="o_app_icon rounded-4 shadow-sm"
                                     t-att-src="app.webIconData"
                                     style="width:85px;height:85px;object-fit:cover;" />
                                
                                <div t-else=""
                                     class="o_app_icon d-flex align-items-center justify-content-center rounded-4 shadow-sm bg-primary text-white"
                                     style="width:85px;height:85px;">
                                    <i class="fa fa-th-large fa-2x"/>
                                </div>
                                
                                <div class="o_caption mt-2 text-dark fw-medium" t-esc="app.name"/>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>