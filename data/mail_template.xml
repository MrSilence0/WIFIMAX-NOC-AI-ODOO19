<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_noc_ticket_created" model="mail.template">
            <field name="name">NOC Ticket Asignado</field>
            <field name="model_id" ref="wifimax_noc_ai.model_wifimax_noc_ticket"/>
            <field name="subject">Nuevo Ticket NOC: {{ object.name }}</field>
            <field name="email_to">{{ object.assigned_user_id.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <h2>Nuevo Ticket NOC Asignado</h2>
                    <p>Se ha generado un nuevo ticket y fue asignado a su usuario.</p>
                    <table border="1" cellpadding="5">
                        <tr>
                            <td><strong>Ticket</strong></td>
                            <td><t t-out="object.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Cliente</strong></td>
                            <td><t t-out="object.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Prioridad</strong></td>
                            <td><t t-out="dict(object._fields['priority'].selection).get(object.priority)"/></td>
                        </tr>
                        <tr>
                            <td><strong>Estado</strong></td>
                            <td><t t-out="dict(object._fields['status'].selection).get(object.status)"/></td>
                        </tr>
                        <tr>
                            <td><strong>IP Equipo</strong></td>
                            <td><t t-out="object.device_ip"/></td>
                        </tr>
                        <tr>
                            <td><strong>Fecha Detección</strong></td>
                            <td><t t-out="object.detection_date"/></td>
                        </tr>
                        <tr>
                            <td><strong>SLA</strong></td>
                            <td><t t-out="object.sla_deadline"/></td>
                        </tr>
                    </table>
                    <br/>
                    <strong>Descripción:</strong>
                    <div style="margin-top:8px; line-height:1.6;">
                        <t t-raw="object.description_html"/>
                    </div>
                    <br/>
                    <p style="text-align:center;">
                        <a t-attf-href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/odoo/action-wifimax_noc_ai.action_noc_ticket/{{ object.id }}"
                        style="background-color:#7C3A6B;color:white;padding:12px 24px;
                                text-decoration:none;border-radius:4px;font-weight:bold;">
                            Ver Ticket en Odoo
                        </a>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>