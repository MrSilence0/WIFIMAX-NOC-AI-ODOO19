<odoo>

    <!-- =========================
            TECHNICIANS
    ========================== -->

    <record id="rule_noc_ticket_user" model="ir.rule">
        <field name="name">Technician Own Tickets</field>
        <field name="model_id" ref="model_wifimax_noc_ticket"/>
        <field name="groups" eval="[(4, ref('wifimax_noc_ai.group_noc_user'))]"/>
        <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
    </record>


    <!-- =========================
            MANAGERS
    ========================== -->

    <record id="rule_noc_ticket_manager" model="ir.rule">
        <field name="name">Manager All Tickets</field>
        <field name="model_id" ref="model_wifimax_noc_ticket"/>
        <field name="groups" eval="[(4, ref('wifimax_noc_ai.group_noc_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>


    <!-- =========================
            PORTAL USERS
    ========================== -->
    
    <record id="rule_noc_ticket_portal" model="ir.rule">
        <field name="name">Client Own Tickets</field>
        <field name="model_id" ref="model_wifimax_noc_ticket"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>

</odoo>