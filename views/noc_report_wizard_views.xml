<odoo>

    <record id="view_noc_report_wizard_form" model="ir.ui.view">
        <field name="name">wifimax.noc.report.wizard.form</field>
        <field name="model">wifimax.noc.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Reporte NOC">

                <header>

                    <button
                        name="action_generate"
                        type="object"
                        string="Generar Reporte"
                        class="btn-primary"
                    />

                    <button
                        name="action_print_pdf"
                        type="object"
                        string="Exportar PDF"
                        class="btn-secondary"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>Reporte NOC</h1>
                    </div>

                    <!-- =========================
                        FILTROS
                    ========================== -->

                    <group string="Filtros">

                        <group>

                            <field name="partner_id"/>

                        </group>

                        <group>

                            <field name="date_from"/>

                            <field name="date_to"/>

                        </group>

                    </group>

                    <!-- =========================
                        MÉTRICAS
                    ========================== -->

                    <group string="Resumen Ejecutivo">

                        <group>

                            <field name="total_tickets" readonly="1"/>

                            <field name="open_tickets" readonly="1"/>

                            <field name="resolved_tickets" readonly="1"/>

                        </group>

                        <group>

                            <field name="sla_expired" readonly="1"/>

                            <field name="sla_warning" readonly="1"/>

                            <field name="avg_sla_hours" readonly="1"/>

                        </group>

                    </group>

                    <!-- =========================
                        PESTAÑAS
                    ========================== -->

                    <notebook>

                        <page string="Observaciones">

                            <field
                                name="notes"
                                nolabel="1"
                                placeholder="Ingrese comentarios, conclusiones y recomendaciones..."
                            />

                        </page>

                        <page string="Indicadores">

                            <group>

                                <group>

                                    <field name="total_tickets" readonly="1"/>

                                    <field name="open_tickets" readonly="1"/>

                                    <field name="resolved_tickets" readonly="1"/>

                                </group>

                                <group>

                                    <field name="sla_expired" readonly="1"/>

                                    <field name="sla_warning" readonly="1"/>

                                    <field name="avg_sla_hours" readonly="1"/>

                                </group>

                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

</odoo>