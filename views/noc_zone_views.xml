<odoo>

    <record id="view_noc_zone_list" model="ir.ui.view">
        <field name="name">wifimax.noc.zone.list</field>
        <field name="model">wifimax.noc.zone</field>
        <field name="arch" type="xml">
            <list string="Zonas NOC">
                <field name="name"/>
                <field name="description"/>
                <field name="technician_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_noc_zone_form" model="ir.ui.view">
        <field name="name">wifimax.noc.zone.form</field>
        <field name="model">wifimax.noc.zone</field>
        <field name="arch" type="xml">
            <form string="Zona NOC">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <group string="Técnicos asignados">
                        <field name="technician_ids"
                               widget="many2many_tags"
                               domain="[('share', '=', False)]"
                               nolabel="1"/>
                    </group>
                    <group string="Ubicaciones">
                        <field name="partner_ids"
                               nolabel="1"
                               readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_noc_zone" model="ir.actions.act_window">
        <field name="name">Zonas NOC</field>
        <field name="res_model">wifimax.noc.zone</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>