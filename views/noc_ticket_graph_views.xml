<odoo>

    <record id="view_noc_ticket_graph" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.graph</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <graph string="SLA Analysis" type="bar">

                <field name="assigned_user_id"/>

                <field name="sla_hours" type="measure"/>

            </graph>

        </field>

    </record>


    <record id="view_noc_ticket_graph_pie" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.graph.pie</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <graph string="Critical Tickets" type="pie">

                <field name="zabbix_severity"/>

            </graph>

        </field>

    </record>

</odoo>