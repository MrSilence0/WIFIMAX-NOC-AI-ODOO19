<odoo>

    <!-- =========================
            PIVOT KPI
    ========================== -->

    <record id="view_noc_ticket_pivot"
            model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.pivot</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <pivot string="Tickets KPI">

                <field name="assigned_user_id" type="row"/>

                <field name="status" type="col"/>

                <field name="ticket_count" type="measure"/>

                <field name="sla_hours" type="measure"/>

            </pivot>

        </field>

    </record>


    <!-- =========================
            SLA COMPLIANCE
    ========================== -->

    <record id="view_noc_ticket_pivot_sla"
            model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.pivot.sla</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <pivot string="SLA Compliance">

                <field name="sla_status" type="row"/>

                <field name="priority" type="col"/>

            </pivot>

        </field>

    </record>


    <!-- =========================
            CRITICAL ANALYSIS
    ========================== -->

    <record id="view_noc_ticket_pivot_critical"
            model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.pivot.critical</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <pivot string="Critical Tickets">

                <field name="assigned_user_id" type="row"/>

                <field name="zabbix_severity" type="col"/>

                <field name="sla_hours" type="measure"/>

                <field name="ticket_count" type="measure"/>

            </pivot>

        </field>

    </record>

</odoo>