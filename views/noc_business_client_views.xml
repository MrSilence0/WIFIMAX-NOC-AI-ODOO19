<odoo>

    <!-- =========================
         TREE VIEW
    ========================== -->

    <record id="view_noc_business_partner_tree"
            model="ir.ui.view">

        <field name="name">res.partner.business.tree</field>

        <field name="model">res.partner</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>

                <field name="vat"/>

                <field name="phone"/>

                <field name="email"/>

                <field name="website"/>

                <field name="city"/>

                <field name="state_id"/>

                <field name="country_id"/>

                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- =========================
         SEARCH VIEW
    ========================== -->

    <record id="view_noc_business_partner_search"
            model="ir.ui.view">

        <field name="name">res.partner.business.search</field>

        <field name="model">res.partner</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="vat"/>

                <filter
                    name="companies"
                    string="Empresas"
                    domain="[('is_company','=',True)]"
                />

            </search>

        </field>

    </record>


    <!-- =========================
         ACTION
    ========================== -->

    <record id="action_business_clients"
            model="ir.actions.act_window">

        <field name="name">Clientes Empresariales</field>

        <field name="res_model">res.partner</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
            ref="view_noc_business_partner_search"/>

        <field name="domain">
            [('is_company','=',True)]
        </field>

        <field name="context">
            {
                'default_is_company': True,
                'default_company_type': 'company'
            }
        </field>

    </record>


    <!-- =========================
         TREE VIEW ASOCIADA
    ========================== -->

    <record id="action_business_clients_tree"
            model="ir.actions.act_window.view">

        <field name="sequence" eval="1"/>

        <field name="view_mode">list</field>

        <field name="view_id"
               ref="view_noc_business_partner_tree"/>

        <field name="act_window_id"
               ref="action_business_clients"/>

    </record>

</odoo>